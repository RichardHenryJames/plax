# Environment Variables

# Google Gemini API (primary AI)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API (fastest first provider)
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenRouter free models, last-resort fallback
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Azure Translator, translation fallback
# AZURE_TRANSLATOR_KEY=your_azure_translator_key_here
# AZURE_TRANSLATOR_REGION=global

# Optional AI tuning. Comma-separated provider:model pairs, fastest first.
# LLM_CHAIN=groq:qwen/qwen3.8-27b,gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-20b
# LLM_TRANSLATE_CHAIN=gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b
# LLM_HEDGE_MS=1500

# Supabase (coming soon)
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: the secret that signs story cards for shared story pages (16+ characters). When unset, the key is derived
# from SUPABASE_SERVICE_ROLE_KEY, so nothing needs to be added. Server only.
# SHARE_SECRET=a_long_random_string

# Optional: Google ads on the website. With none of these set there are no ads: no script is loaded, no space is kept at the foot of
# the page and no ad stands between stories. They are ids, not secrets, and are built into the page, so set them where the site is built.
# The AdSense publisher id, and the three ad units made in AdSense (Ads > By ad unit > Display ads):
#   the strip at the foot of the page, as two fixed sizes (320 x 50 for phones, 728 x 90 for a wide window), and the full-page card
#   that stands after every fifth story (a responsive unit, set to the rectangle shape). The strip and the card are switched on apart.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# NEXT_PUBLIC_ADSENSE_SLOT_STRIP_NARROW=0000000000
# NEXT_PUBLIC_ADSENSE_SLOT_STRIP_WIDE=0000000000
# NEXT_PUBLIC_ADSENSE_SLOT_PAGE=0000000000
# Boxes where the ads would be, and nothing sent to Google: for looking at the layout. Never set in production.
# NEXT_PUBLIC_ADS_PREVIEW=true
