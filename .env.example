# Environment Variables

# Google Gemini API (primary AI)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API (fastest first provider)
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenRouter free models, last-resort fallback
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Azure Translator, translation fallback
# AZURE_TRANSLATOR_KEY=your_azure_translator_key_here
# AZURE_TRANSLATOR_REGION=global

# Optional AI tuning. Comma-separated provider:model pairs, fastest first.
# LLM_CHAIN=groq:qwen/qwen3.8-27b,gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-20b
# LLM_TRANSLATE_CHAIN=gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b
# LLM_HEDGE_MS=1500

# Supabase (coming soon)
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
