{
  "about": "Cases for the rules of public/app-config.json. Each is a document (config, an object, or json, the text itself where the way a number is written matters), what the app must refuse of it (rejected: the sections or parts it keeps its built-in value for) and what only the website's check also flags (webOnly: names the app ignores but an owner probably mistyped). A piece of a string of the form @repeat:c:n stands for the character c written n times. Run by src/lib/app-config.test.mjs (src/lib/app-config-rules.ts) and by the app's own test (mobile/src/config/__tests__/app-config.test.ts, with mobile/src/config/app-config.ts): the two must agree on every case, so a file the website's check passes is a file the app takes whole. ASCII only, so that every character that matters is visible here as an escape.",
  "cases": [
    { "name": "nothing but the schema", "config": { "schemaVersion": 1 }, "rejected": [] },
    { "name": "schema 2", "config": { "schemaVersion": 2 }, "rejected": ["schemaVersion"] },
    { "name": "schema as text", "config": { "schemaVersion": "1" }, "rejected": ["schemaVersion"] },
    { "name": "schema written 1.0", "json": "{\"schemaVersion\":1.0}", "rejected": ["schemaVersion"] },
    { "name": "no schema", "config": {}, "rejected": ["schemaVersion"] },
    { "name": "not JSON: a trailing comma", "json": "{\"schemaVersion\":1,}", "rejected": ["schemaVersion"] },
    { "name": "not JSON: a name twice", "json": "{\"schemaVersion\":1,\"schemaVersion\":1}", "rejected": ["schemaVersion"] },
    { "name": "not JSON: something after the value", "json": "{\"schemaVersion\":1} x", "rejected": ["schemaVersion"] },
    { "name": "not JSON: a comment", "json": "// a\n{\"schemaVersion\":1}", "rejected": ["schemaVersion"] },
    { "name": "not JSON: single quotes", "json": "{'schemaVersion':1}", "rejected": ["schemaVersion"] },
    { "name": "not JSON: a leading zero", "json": "{\"schemaVersion\":01}", "rejected": ["schemaVersion"] },
    { "name": "not JSON: NaN", "json": "{\"schemaVersion\":1,\"a\":NaN}", "rejected": ["schemaVersion"] },
    { "name": "a byte order mark", "json": "\ufeff{\"schemaVersion\":1}", "rejected": ["schemaVersion"] },
    { "name": "seven levels", "json": "{\"schemaVersion\":1,\"a\":[[[[[[[1]]]]]]]}", "rejected": ["schemaVersion"] },
    { "name": "five levels", "json": "{\"schemaVersion\":1,\"a\":[[[[[1]]]]]}", "rejected": [], "webOnly": ["unknown:a"] },
    { "name": "the root is a list", "json": "[]", "rejected": ["schemaVersion"] },
    { "name": "an unknown top-level field", "config": { "schemaVersion": 1, "extra": 1 }, "rejected": [], "webOnly": ["unknown:extra"] },

